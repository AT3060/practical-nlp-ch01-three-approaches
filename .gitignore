# --- Python virtual environment (never commit it: it is large and machine-specific)
.venv/
venv/
env/

# --- Python cache files
__pycache__/
*.py[cod]

# --- Jupyter auto-save checkpoints
.ipynb_checkpoints/

# --- Downloaded dataset (re-downloaded automatically by src/utils.py)
data/

# --- Saved model weights (hundreds of MB; GitHub rejects files > 100 MB)
models/

